# ═══════════════════════════════════════════════════════════
# InView VROOM — React frontend image (multi-stage)
#
# Stage 1 builds the Vite + React SPA to /build/dist.
# Stage 2 is the existing FastAPI backend, serving that built
# SPA from the same FRONTEND_DIR (/app/frontend) the backend
# already uses — so no backend code changes are needed.
#
# This image is NOT yet wired into docker-compose (the live
# stack still builds the vanilla `Dockerfile`). It exists so the
# React build can be tested and is one switch away from cutover.
# See REACT_CUTOVER.md for the cutover + rollback runbook.
#
# Build (the anon key is a public client key, safe to bake in):
#   docker build -f Dockerfile.react \
#     --build-arg VITE_SUPABASE_URL=... \
#     --build-arg VITE_SUPABASE_ANON_KEY=... -t yuroute-react .
# ═══════════════════════════════════════════════════════════

# ── Stage 1: build the React (Vite) SPA ──────────────────────
FROM node:22-slim AS frontend-build
WORKDIR /build

# Install deps first for layer caching
COPY frontend-react/package.json frontend-react/package-lock.json ./
RUN npm ci

# Vite inlines VITE_* at build time. .env is .dockerignored, so the
# public Supabase config is supplied via build args -> env.
ARG VITE_SUPABASE_URL
ARG VITE_SUPABASE_ANON_KEY
ENV VITE_SUPABASE_URL=$VITE_SUPABASE_URL
ENV VITE_SUPABASE_ANON_KEY=$VITE_SUPABASE_ANON_KEY

COPY frontend-react/ ./
RUN npm run build

# ── Stage 2: FastAPI backend serving the built SPA ───────────
FROM python:3.12-slim
WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt /app/backend/requirements.txt
RUN pip install --no-cache-dir -r /app/backend/requirements.txt

COPY backend/ /app/backend/

# Serve the built React app from the path the backend already serves.
COPY --from=frontend-build /build/dist/ /app/frontend/

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:8000/api/health || exit 1

WORKDIR /app/backend
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
